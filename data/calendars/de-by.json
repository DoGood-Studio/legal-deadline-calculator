{
  "$schema": "../../spec/calendar.schema.json",
  "id": "de-by",
  "extends": "de",
  "name": {
    "en": "Germany — Bavaria (Bayern)",
    "de": "Deutschland — Bavaria (Bayern)"
  },
  "holidays": [
    {
      "id": "epiphany",
      "name": {
        "en": "Epiphany",
        "de": "Heilige Drei Könige"
      },
      "rule": {
        "type": "fixed",
        "month": 1,
        "day": 6
      }
    },
    {
      "id": "corpus_christi",
      "name": {
        "en": "Corpus Christi",
        "de": "Fronleichnam"
      },
      "rule": {
        "type": "easter",
        "offset": 60
      }
    },
    {
      "id": "all_saints",
      "name": {
        "en": "All Saints' Day",
        "de": "Allerheiligen"
      },
      "rule": {
        "type": "fixed",
        "month": 11,
        "day": 1
      }
    }
  ],
  "description": {
    "en": "Assumption Day (15 August) is a holiday only in municipalities with a predominantly Catholic population: use de-by-catholic for those (e.g. Munich, Augsburg) and de-by-augsburg for the city of Augsburg."
  }
}
