{
  "$schema": "../../spec/calendar.schema.json",
  "id": "eu-cj",
  "name": {
    "en": "European Union — official holidays of the Court of Justice and the General Court"
  },
  "description": {
    "en": "Official holidays observed by the Court of Justice (Rules of Procedure Art. 24(6)) and applied by the General Court (Art. 58(3)). Judicial vacations do not suspend time limits and are not listed. The list is published annually in the Official Journal; coverage is limited to the years verified."
  },
  "timezone": "Europe/Luxembourg",
  "weekend": [
