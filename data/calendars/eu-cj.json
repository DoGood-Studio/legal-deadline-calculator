    7
  ],
  "coverage": {
    "from": 2025,
    "to": 2026
  },
  "sources": [
    {
      "title": "Court of Justice decision C/2025/1569 (OJ C)",
      "url": "http://data.europa.eu/eli/C/2025/1569/oj"
    }
  ],
