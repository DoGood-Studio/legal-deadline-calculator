{
  "$schema": "../../spec/calendar.schema.json",
  "id": "us-ma",
  "extends": "us",
  "name": {
    "en": "United States — federal holidays plus Massachusetts state holidays"
  },
  "description": {
    "en": "Adds Massachusetts state holidays (kind 'state'). Evacuation Day and Bunker Hill Day are legal holidays in Suffolk County only; they have the kind 'suffolk' and do not move a deadline."
  },
  "sources": [
    {
      "title": "Mass. Gen. Laws ch. 4, § 7",
      "url": "https://malegislature.gov/Laws/GeneralLaws/PartI/TitleI/Chapter4/Section7"
    }
  ],
  "holidays": [
    {
      "id": "patriots_day",
      "name": {
        "en": "Patriots' Day"
      },
      "rule": {
        "type": "nth_weekday",
        "month": 4,
        "weekday": 1,
        "n": 3
      },
      "kind": "state",
      "source": "M.G.L. c. 4, § 7"
    },
    {
      "id": "evacuation_day",
      "name": {
        "en": "Evacuation Day (Suffolk County)"
      },
      "rule": {
        "type": "fixed",
        "month": 3,
        "day": 17
      },
      "kind": "suffolk",
      "observed": {
        "shift": {
          "7": 1
        }
      },
      "source": "M.G.L. c. 4, § 7, cl. Eighteenth"
    },
    {
      "id": "bunker_hill_day",
      "name": {
        "en": "Bunker Hill Day (Suffolk County)"
      },
      "rule": {
        "type": "fixed",
        "month": 6,
        "day": 17
      },
      "kind": "suffolk",
      "observed": {
        "shift": {
          "7": 1
        }
      },
      "source": "M.G.L. c. 4, § 7, cl. Eighteenth"
    }
  ]
}
