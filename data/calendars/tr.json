{
  "$schema": "../../spec/calendar.schema.json",
  "id": "tr",
  "name": {
    "en": "Türkiye — official holidays (Law No. 2429)",
    "tr": "Türkiye — resmî tatiller (2429 sayılı Kanun)"
  },
  "description": {
    "en": "National holidays and general holidays under Law No. 2429, with Saturday and Sunday as non-working days for public offices and courts (Law No. 657 Art. 99). Eves of the religious feasts and 28 October are half days from 13:00. Feast dates are taken from the Presidency of Religious Affairs (Diyanet) calendar; dates after the current year are Diyanet's published calculations.",
    "tr": "2429 sayılı Kanun'daki ulusal bayram ve genel tatiller; resmî daireler ve mahkemeler için Cumartesi ve Pazar çalışılmayan günlerdir (657 s.K. m.99). Dinî bayram arifeleri ve 28 Ekim 13.00'ten itibaren yarım gündür. Bayram tarihleri Diyanet İşleri Başkanlığı takviminden alınmıştır; içinde bulunulan yıldan sonraki tarihler Diyanet'in yayımladığı hesaplamalardır."
  },
  "timezone": "Europe/Istanbul",
  "weekend": [
    6,
    7
  ],
  "coverage": {
    "from": 2000,
    "to": 2035
  },
  "sources": [
    {
      "title": "Law No. 2429 on National Holidays and General Holidays",
      "url": "https://www.mevzuat.gov.tr/MevzuatMetin/1.5.2429.pdf"
    },
    {
      "title": "Law No. 657 on Civil Servants, Art. 99",
      "url": "https://www.mevzuat.gov.tr/MevzuatMetin/1.5.657.pdf"
    },
    {
      "title": "Diyanet İşleri Başkanlığı — Dinî Günler",
      "url": "https://vakithesaplama.diyanet.gov.tr/dinigunler.php"
    }
  ],
