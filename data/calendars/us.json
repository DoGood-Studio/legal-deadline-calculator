{
  "$schema": "../../spec/calendar.schema.json",
  "id": "us",
  "name": {
    "en": "United States — federal legal public holidays (5 U.S.C. § 6103)"
  },
  "description": {
    "en": "Federal legal public holidays. A holiday on Sunday is observed on Monday (5 U.S.C. § 6103(b)). A holiday on Saturday is observed by federal employees on the preceding Friday (Executive Order 11582); that Friday has the kind 'observed_friday' because whether it is a 'legal holiday' for court deadlines is unsettled. State holidays are separate calendars (us-<state>) with the kind 'state'."
  },
  "timezone": null,
  "weekend": [
    6,
    7
  ],
  "coverage": {
    "from": 1986,
    "to": 2099
  },
  "sources": [
    {
      "title": "5 U.S.C. § 6103",
      "url": "https://www.law.cornell.edu/uscode/text/5/6103"
    },
    {
      "title": "Executive Order 11582",
      "url": "https://www.archives.gov/federal-register/codification/executive-order/11582.html"
    }
  ],
