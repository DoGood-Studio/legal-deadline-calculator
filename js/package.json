{
  "name": "lexdays",
  "version": "0.1.0",
  "description": "Explainable legal deadline and business-day calculator. Every result cites the rule it applied. Zero dependencies.",
  "keywords": [
    "legal deadline",
    "deadline calculator",
    "business days",
    "working days",
    "holidays",
    "court rules",
    "rules as code",
    "statute of limitations",
    "süre hesaplama",
    "iş günü",
    "adli tatil",
    "turkey"
  ],
  "license": "MIT",
  "author": "DoGood-Studio",
  "homepage": "https://github.com/DoGood-Studio/lexdays#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoGood-Studio/lexdays.git",
    "directory": "js"
  },
  "bugs": "https://github.com/DoGood-Studio/lexdays/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gen": "node scripts/gen-data.mjs",
    "build": "npm run gen && tsup",
    "typecheck": "npm run gen && tsc --noEmit",
    "test": "npm run gen && vitest run",
    "coverage": "npm run gen && vitest run --coverage",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
