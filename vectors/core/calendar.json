{
  "description": "Engine conformance vectors for calendars. Expected values were derived by hand from a wall calendar, not generated by the code under test. Both the Python and TypeScript packages must pass every case.",
  "calendars": {
    "fx": {
      "id": "fx",
      "name": {
        "en": "Fixture calendar",
        "tr": "Test takvimi"
      },
      "weekend": [
        6,
        7
      ],
      "coverage": {
        "from": 2020,
        "to": 2030
      },
      "holidays": [
        {
          "id": "new_year",
          "name": {
            "en": "New Year",
            "tr": "Yılbaşı"
          },
          "rule": {
            "type": "fixed",
            "month": 1,
            "day": 1
          },
          "observed": {
            "shift": {
              "6": -1,
              "7": 1
            }
          }
        },
        {
          "id": "spring_day",
          "name": {
            "en": "Spring Day"
          },
          "rule": {
            "type": "nth_weekday",
            "month": 5,
            "weekday": 1,
            "n": -1
          }
        },
        {
          "id": "good_friday",
          "name": {
            "en": "Good Friday"
          },
          "rule": {
            "type": "easter",
            "offset": -2
          }
        },
        {
          "id": "eve_half",
          "name": {
            "en": "Eve"
          },
          "rule": {
            "type": "fixed",
            "month": 10,
            "day": 28
          },
          "half_day": {
            "from": "13:00"
          }
        },
        {
          "id": "harvest_eve",
          "name": {
            "en": "Harvest Eve",
            "tr": "Hasat Arifesi"
          },
          "rule": {
            "type": "dates",
            "dates": [
              "2026-03-19"
            ]
          },
          "half_day": {
            "from": "13:00"
          }
        },
        {
          "id": "harvest",
          "name": {
            "en": "Harvest Feast",
            "tr": "Hasat Bayramı"
          },
          "rule": {
            "type": "dates",
            "dates": [
              "2026-03-20",
              "2026-03-21",
              "2026-03-22"
            ]
          }
        },
        {
          "id": "admin_leave",
          "name": {
            "en": "Administrative leave"
          },
          "kind": "administrative",
          "rule": {
            "type": "dates",
            "dates": [
              "2026-03-23"
            ]
          }
        },
        {
          "id": "midsummer",
          "name": {
            "en": "Midsummer"
          },
          "rule": {
            "type": "weekday_relative",
            "month": 6,
            "day": 20,
            "weekday": 6,
            "direction": "on_or_after"
          }
        },
        {
          "id": "xmas",
          "name": {
            "en": "Christmas"
          },
          "rule": {
            "type": "fixed",
            "month": 12,
            "day": 25
          },
          "observed": {
            "shift": {
              "6": 2,
              "7": 1
            },
            "avoid_collision": true
          }
        },
        {
          "id": "boxing",
          "name": {
            "en": "Boxing Day"
          },
          "rule": {
            "type": "fixed",
            "month": 12,
            "day": 26
          },
          "observed": {
            "shift": {
              "6": 2,
              "7": 1
            },
            "avoid_collision": true
          }
        },
        {
          "id": "orthodox_easter_monday",
          "name": {
            "en": "Orthodox Easter Monday"
          },
          "rule": {
            "type": "easter",
            "offset": 1,
            "method": "orthodox"
          },
          "since": 2025,
          "except_years": [
            2027
          ]
        }
      ],
      "one_off": [
        {
          "id": "jubilee",
          "name": {
            "en": "Jubilee"
          },
          "date": "2026-06-01"
