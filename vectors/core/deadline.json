{
  "description": "Engine conformance vectors for rule packs. Uses the fixture calendar from calendar.json. Expected deadlines were derived by hand.",
  "uses_calendars_from": "calendar.json",
  "rulepacks": {
    "fx/civil": {
      "id": "fx/civil",
      "name": {
        "en": "Fixture civil procedure",
        "tr": "Test hukuk usulü"
      },
      "calendar": "fx",
      "options": {
        "service": {
          "values": [
            "personal",
            "electronic"
          ],
          "default": "personal"
        },
        "eve_rule": {
          "values": [
            "working",
            "non_working"
          ],
          "default": "working"
        },
        "filing": {
          "values": [
            "paper",
            "electronic"
          ],
          "default": "paper"
        }
      },
      "non_working": {
        "half_days": {
          "$option": "eve_rule"
        }
      },
      "citations": {
        "count": {
          "label": {
            "en": "Art. 1",
            "tr": "m.1"
          }
        },
        "recess": {
          "label": {
            "en": "Art. 2",
            "tr": "m.2"
          }
        },
        "roll": {
          "label": {
            "en": "Art. 3",
            "tr": "m.3"
          }
        },
        "service": {
          "label": {
            "en": "Art. 4",
            "tr": "m.4"
          }
        }
      },
      "steps": [
        {
          "type": "shift_trigger",
          "days": 5,
          "when": {
            "option": "service",
            "equals": "electronic"
          },
          "cite": "service"
        },
        {
          "type": "count",
          "cite": "count"
        },
        {
          "type": "recess",
          "name": {
            "en": "summer recess",
            "tr": "yaz tatili"
          },
          "periods": [
            {
              "start": "07-20",
              "end": "08-31"
            }
          ],
          "mode": "extend",
          "extension_days": 7,
          "cite": "recess"
        },
        {
          "type": "roll",
          "cite": "roll"
        },
        {
          "type": "ends_at",
          "time": "23:59",
          "when": {
            "option": "filing",
            "equals": "electronic"
          }
        },
        {
          "type": "notice",
          "code": "eve-disputed",
          "text": {
            "en": "Eve rule is disputed.",
            "tr": "Arife kuralı tartışmalı."
          },
          "when": {
            "option": "eve_rule",
            "equals": "non_working"
          }
        }
      ]
    },
    "fx/clear": {
      "id": "fx/clear",
      "name": {
        "en": "Fixture clear-days rules"
      },
      "calendar": "fx",
      "steps": [
        {
          "type": "count",
          "business_days": true,
          "when": {
            "unit": "day",
            "max_amount": 5
          }
        },
        {
          "type": "count",
          "clear_days": true,
          "when": {
            "not": {
              "unit": "day",
              "max_amount": 5
            }
          }
        },
        {
          "type": "roll"
        }
      ]
    },
    "fx/inclusive": {
      "id": "fx/inclusive",
      "name": {
        "en": "Fixture inclusive counting"
      },
      "calendar": "fx",
      "steps": [
        {
          "type": "count",
          "exclude_start_day": false
        },
        {
          "type": "roll"
        }
      ]
    },
    "fx/suspend": {
      "id": "fx/suspend",
      "name": {
        "en": "Fixture suspension"
      },
      "calendar": "fx",
      "steps": [
        {
          "type": "count"
        },
        {
          "type": "recess",
          "name": {
            "en": "August suspension"
          },
          "periods": [
            {
              "start": "08-01",
              "end": "08-31"
            }
          ],
          "mode": "suspend"
        },
        {
          "type": "roll"
        }
      ]
    },
    "fx/winter": {
      "id": "fx/winter",
      "name": {
        "en": "Fixture winter recess"
      },
      "calendar": "fx",
      "steps": [
        {
          "type": "count"
        },
        {
          "type": "recess",
          "name": {
            "en": "winter recess"
          },
          "periods": [
            {
              "start": "12-20",
              "end": "01-10"
            }
          ],
          "mode": "extend",
          "extension_days": 3
        },
        {
          "type": "roll"
        }
      ]
    },
    "fx/mail": {
      "id": "fx/mail",
      "name": {
        "en": "Fixture add-on days"
      },
      "calendar": "fx",
      "options": {
        "service": {
          "values": [
            "electronic",
            "mail"
          ],
          "default": "electronic"
        }
      },
      "steps": [
        {
          "type": "count"
        },
        {
          "type": "roll"
        },
        {
          "type": "add_days",
          "days": 3,
          "when": {
            "option": "service",
            "equals": "mail"
          }
        },
        {
          "type": "roll",
          "when": {
            "option": "service",
            "equals": "mail"
          }
        }
      ]
    },
    "fx/versioned": {
      "id": "fx/versioned",
      "name": {
        "en": "Fixture versioned rules"
      },
      "calendar": "fx",
      "steps": [
        {
          "type": "count",
          "when": {
            "trigger_before": "2026-06-01"
          }
        },
        {
          "type": "count",
          "business_days": true,
          "when": {
            "trigger_from": "2026-06-01"
          }
        },
        {
          "type": "recess",
          "name": {
            "en": "summer recess",
            "tr": "yaz tatili"
          },
          "periods": [
            {
              "start": "07-20",
              "end": "08-31"
            }
          ],
          "extension_days": 7,
          "count_from": "day_after_end"
        },
        {
          "type": "roll"
        },
        {
          "type": "notice",
          "code": "rolled-into-recess",
          "text": {
            "en": "The last day was moved into the recess.",
            "tr": "Son gün tatil dönemine kaydı."
          },
          "when": {
            "date_within": [
              {
                "start": "07-20",
                "end": "08-31"
              }
            ]
          }
        }
      ]
    }
  },
